# Copie este arquivo para ".env" (na mesma pasta backend) e preencha.
# O .env NUNCA vai para o GitHub (está no .gitignore). Não mande a chave para ninguém.

# ---------- Assistente com IA (opcional, 4.10) ----------
# Sem chave, o assistente funciona só com a Central de Ajuda.
# Use UMA das duas opções:

# Opção 1 · Google Gemini (tem faixa gratuita; no gratuito o Google pode usar o conteúdo para melhorar os produtos dele)
# Crie a chave em https://aistudio.google.com  →  "Get API key"
GEMINI_API_KEY=

# Opção 2 · Anthropic Claude (pago por uso)
# Crie a chave no Claude Console (veja https://docs.claude.com)
ANTHROPIC_API_KEY=

# Se preencher as duas, escolha qual usar: gemini ou claude
IA_PROVEDOR=

# Opcional: trocar o modelo (padrão: gemini-3.5-flash-lite ou claude-haiku-4-5-20251001)
IA_MODELO=

# Limites para não gerar custo surpresa
IA_LIMITE_POR_PESSOA=20
IA_LIMITE_DIARIO=300
